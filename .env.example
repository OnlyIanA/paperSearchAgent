DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LOCAL_EMBEDDING_DIMENSIONS=384

APP_ENV=development
CORS_ORIGINS=http://localhost:2299,http://127.0.0.1:2299

SQLITE_PATH=./backend/data/paper_agent.sqlite3
CHROMA_PERSIST_DIR=./backend/data/chroma

ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_DEFAULT_MAX_RESULTS=5
REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=3600

CHUNK_SIZE=900
CHUNK_OVERLAP=120
RAG_TOP_K=5
MAX_PAPER_CHARS=12000
SHORT_TERM_WINDOW=16
CONVERSATION_SUMMARY_THRESHOLD=10
